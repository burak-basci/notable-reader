{
  "manifest_version": 3,
  "name": "Notable Reader — Artikel & PDF vorlesen",
  "short_name": "Notable Reader",
  "version": "2.3.0",
  "description": "Artikel, PDFs und Bücher lokal vorlesen. Audioexport in der Erweiterung mit Premium, auf unserer Website kostenlos.",
  "homepage_url": "https://reader.benotable.de/",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Notable Reader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; media-src 'self' blob:; connect-src 'self' https://reader-premium.benotable.de https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co;"
  },
  "host_permissions": [
    "https://reader-premium.benotable.de/*"
  ],
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "player-surface.mjs",
        "formatting.mjs",
        "appearance.mjs",
        "ui-locales.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ]
}
