{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "beNotable!",
  "version": "2.5.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "key": "",
  "host_permissions": [],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "unlimitedStorage"
  ],
  "optional_permissions": [
    "downloads",
    "sidePanel",
    "webNavigation"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; worker-src 'self'; media-src 'self' blob:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co https://*.xethub.hf.co;"
  },
  "minimum_chrome_version": "123",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "MacCtrl+Shift+V"
      },
      "description": "__MSG_actionTitle__"
    },
    "toggle-play": {
      "suggested_key": {
        "default": "Alt+Shift+K",
        "mac": "MacCtrl+Shift+K"
      },
      "description": "__MSG_cmdTogglePlay__"
    },
    "previous-section": {
      "suggested_key": {
        "windows": "Alt+Shift+Left",
        "linux": "Alt+Shift+Left",
        "chromeos": "Alt+Shift+Left"
      },
      "description": "__MSG_cmdPreviousSection__"
    },
    "next-section": {
      "suggested_key": {
        "windows": "Alt+Shift+Right",
        "linux": "Alt+Shift+Right",
        "chromeos": "Alt+Shift+Right"
      },
      "description": "__MSG_cmdNextSection__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "session/*.mjs",
        "playback/*.js",
        "models/registry.js",
        "tools/reader/neural-models.js",
        "tools/reader/neural-voices.js",
        "tools/reader/neural-voices-pocket.js",
        "tools/reader/neural-voices-experimental.js",
        "tools/reader/voice-elo.json",
        "samples/*.opus",
        "player-surface.mjs",
        "formatting.mjs",
        "appearance.mjs",
        "appearance-schema.js",
        "config.mjs",
        "platform/keycombo.mjs",
        "ui-locales.json",
        "engine/speech-normalize.mjs",
        "engine/error-keys.mjs",
        "models/voice-catalog.mjs",
        "explain/controller.mjs",
        "explain/annotations.mjs",
        "explain/protocol.mjs",
        "explain/transport.mjs",
        "explain/tutor.mjs",
        "explain/tutor-plan.mjs",
        "explain/tutor-marks.mjs",
        "explain/tutor-card.mjs",
        "scrollbars.mjs",
        "voice-picker.mjs",
        "library/i18n.mjs"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
